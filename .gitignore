# ==============================================================================
# Python .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs & Application logs
*.log
pip-log.txt
pip-delete-this-directory.txt

# Unit test, coverage & code analysis
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.ruff_cache/
cover/

# Environments & Virtual Environments
.env
.env.*
!.env.example
!.env.template
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Local databases & storage
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sqlite3-journal
*-wal
*-shm

# Security & Private keys (SSL / JWT / Certificates)
*.pem
*.key
*.cert
*.crt

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*~
*.code-workspace
.project
.pydevproject
.settings/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# Documentation
/site

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Cython debug output
cython_debug/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
