# Application Environment (development / production)
ENV=development

# JWT Settings
# In production, generate a secure random secret (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=small-start-python
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=taskflow

# Optional: Override the full database URL directly
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/taskflow
